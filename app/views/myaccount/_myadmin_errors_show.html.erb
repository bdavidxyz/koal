<div class="h-full space-y-4">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <%= link_to myaccount_errors_path, class: "inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 mb-1" do %>
        &larr; Back to errors
      <% end %>
      <h1 class="text-xl font-semibold tracking-tight text-gray-900 dark:text-gray-100">Error detail</h1>
      <p class="text-sm font-mono text-gray-600 dark:text-gray-400"><%= @result.data[:request_id] %></p>
    </div>
    <div class="inline-flex items-center rounded-md border border-gray-200 bg-white px-3 py-2 text-sm font-medium text-gray-700 dark:border-gray-800 dark:bg-gray-900 dark:text-gray-200">
      <%= pluralize(@result.data[:lines].size, "log line") %>
    </div>
  </div>

  <div class="rounded-md border border-gray-200 bg-white p-4 dark:border-gray-800 dark:bg-gray-900 lg:p-6">
    <div class="overflow-hidden rounded-md border border-gray-200 dark:border-gray-800">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-gray-200 bg-gray-50 dark:border-gray-800 dark:bg-gray-950">
          <tr>
            <th class="px-4 py-2 font-semibold text-xs uppercase tracking-widest text-gray-400 dark:text-gray-500 w-16">#</th>
            <th class="px-4 py-2 font-semibold text-xs uppercase tracking-widest text-gray-400 dark:text-gray-500">Log line</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 dark:divide-gray-800">
          <% @result.data[:lines].each do |entry| %>
            <tr class="bg-white dark:bg-gray-900">
              <td class="px-4 py-2 font-mono text-xs text-gray-400 dark:text-gray-500 align-top"><%= entry[:index] + 1 %></td>
              <td class="px-4 py-2 font-mono text-xs text-gray-900 dark:text-gray-100 break-all whitespace-pre-wrap"><%= entry[:content] %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
