<div class="h-full space-y-4">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h1 class="text-xl font-semibold tracking-tight text-gray-900 dark:text-gray-100">Errors</h1>
      <p class="text-sm text-gray-600 dark:text-gray-400">
        Request IDs detected from <span class="font-medium"><%= @result.data[:source_label] %></span>
      </p>
    </div>
    <div class="inline-flex items-center rounded-md border border-gray-200 bg-white px-3 py-2 text-sm font-medium text-gray-700 dark:border-gray-800 dark:bg-gray-900 dark:text-gray-200">
      <%= pluralize(@result.data[:errors].size, "error request") %>
    </div>
  </div>

  <div class="rounded-md border border-gray-200 bg-white p-4 dark:border-gray-800 dark:bg-gray-900 lg:p-6">
    <div class="mb-4 flex items-center justify-between">
      <div>
        <h2 class="text-xs font-semibold uppercase tracking-widest text-gray-400 dark:text-gray-500">
          <%= @result.data[:environment] %> source
        </h2>
        <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">
          <span class="font-mono"><%= @result.data[:source_location] %></span>
        </p>
      </div>
    </div>

    <% if @result.data[:errors].any? %>
      <div class="overflow-hidden rounded-md border border-gray-200 dark:border-gray-800">
        <ul class="divide-y divide-gray-200 dark:divide-gray-800">
          <% @result.data[:errors].each do |error| %>
            <li class="bg-white hover:bg-gray-50 dark:bg-gray-900 dark:hover:bg-gray-800">
              <%= link_to myaccount_errors_show_path(id: error[:request_id]), class: "block px-4 py-3" do %>
                <div class="flex items-center justify-between">
                  <span class="font-mono text-sm text-gray-900 dark:text-gray-100"><%= error[:request_id] %></span>
                  <% if error[:timestamp] %>
                    <span class="text-xs text-gray-500 dark:text-gray-400"><%= error[:timestamp] %></span>
                  <% end %>
                </div>
                <% if error[:error_name] %>
                  <div class="mt-1 text-xs font-medium text-red-600 dark:text-red-400"><%= error[:error_name] %></div>
                <% end %>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    <% else %>
      <div class="rounded-md border border-dashed border-gray-300 bg-gray-50 px-4 py-6 text-sm text-gray-600 dark:border-gray-700 dark:bg-gray-950 dark:text-gray-400">
        No error request IDs were found from this source yet.
      </div>
    <% end %>
  </div>
</div>
